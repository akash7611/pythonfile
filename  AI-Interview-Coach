def words(text):
    return set(
        re.findall(r"\b[a-zA-Z]+\b", text.lower())
    )


def analyze(question, answer):

    q_words = words(question)
    a_words = words(answer)

    matched = q_words.intersection(a_words)

    relevance = 0

    if q_words:
        relevance = int(
            len(matched) / len(q_words) * 100
        )

    word_count = len(a_words)

    if word_count >= 80:
        detail = 95
    elif word_count >= 50:
        detail = 85
    elif word_count >= 30:
        detail = 75
    elif word_count >= 15:
        detail = 60
    else:
        detail = 40

    sentences = re.split(r"[.!?]", answer)
    sentences = [x for x in sentences if x.strip()]

    average = (
        word_count / len(sentences)
        if sentences else word_count
    )

    communication = 90 if 8 <= average <= 25 else 70

    score = int(
        relevance * 0.45 +
        communication * 0.25 +
        detail * 0.30
    )

    strengths = []
    weaknesses = []

    if relevance >= 70:
        strengths.append("Answer is relevant to the question.")
    else:
        weaknesses.append(
            "Add more keywords related to the question."
        )

    if communication >= 75:
        strengths.append("Good sentence structure.")
    else:
        weaknesses.append(
            "Try to make your explanation clearer."
        )

    if detail >= 75:
        strengths.append("Good level of detail.")
    else:
        weaknesses.append(
            "Add more explanation and examples."
        )

    if score >= 85:
        suggestion = (
            "Excellent answer! Add a real-world example "
            "to make it even stronger."
        )
    elif score >= 70:
        suggestion = (
            "Good answer. Add technical details "
            "and a practical example."
        )
    elif score >= 50:
        suggestion = (
            "Average answer. Focus on relevant concepts "
            "and explain them clearly."
        )
    else:
        suggestion = (
            "Improve your answer by directly explaining "
            "the concept and adding examples."
        )

    return {
        "score": score,
        "relevance": relevance,
        "communication": communication,
        "detail": detail,
        "strengths": strengths,
        "weaknesses": weaknesses,
        "suggestion": suggestion
    }


@app.route("/")
def home():
    return render_template_string(HTML)


@app.route("/analyze", methods=["POST"])
def analyze_api():

    data = request.get_json()

    question = data.get("question", "")
    answer = data.get("answer", "")

    if not question or not answer:
        return jsonify({
            "error": "Question and answer required"
        }), 400

    return jsonify(
        analyze(question, answer)
    )


if __name__ == "__main__":
    app.run(debug=True)