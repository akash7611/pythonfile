def clean_text(text):
    return re.sub(
        r"[^a-zA-Z0-9 ]",
        "",
        text.lower()
    )


def chatbot(message):

    text = clean_text(message)

    if any(word in text for word in
           ["hello", "hi", "hey", "hii"]):

        return random.choice([
            "👋 Hello! What would you like to learn today?",
            "Hey! 🚀 Ask me any Computer Science question.",
            "Hi! 🤖 I'm ready to help you study."
        ])

    if "thank" in text:
        return "You're welcome! 😊 Keep learning and keep building projects!"

    if "who are you" in text or "your name" in text:
        return "I'm StudyBuddy AI 🤖, your personal study assistant."

    for topic, answer in knowledge.items():

        topic_words = topic.split()

        if all(word in text for word in topic_words):
            return answer

    if "difference" in text:

        if "ai" in text and "ml" in text:
            return """
🤖 AI vs 🧠 ML

AI is the broader concept of machines performing
intelligent tasks.

ML is a subset of AI where machines learn patterns
from data.

In simple words:

AI = Goal
ML = One way to achieve that goal
"""

        if "html" in text and "css" in text:
            return """
HTML → Structure of a webpage 🧱

CSS → Design and appearance 🎨

Example:
HTML creates a button.
CSS makes the button look attractive.
"""

    if "explain" in text:

        return """
Sure! 👍

Please mention the exact topic you want me to explain.

For example:

• Explain Machine Learning
• Explain Python
• Explain DBMS
• Explain SQL
• Explain AI
"""

    return """
🤔 I don't have a specific answer for that topic yet.

Try asking something like:

💡 "What is Machine Learning?"
💡 "Explain Python"
💡 "What is DBMS?"
💡 "Difference between AI and ML"
💡 "What is SQL?"

I'm designed mainly for Computer Science and
study-related questions.
"""


@app.route("/")
def home():
    return render_template_string(HTML)


@app.route("/chat", methods=["POST"])
def chat():

    data = request.get_json()

    message = data.get("message", "")

    if not message:
        return jsonify({
            "reply": "Please type a question 😊"
        })

    reply = chatbot(message)

    return jsonify({
        "reply": reply
    })


if __name__ == "__main__":
    app.run(debug=True)